<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lty.mapper.BookMapper">

    <resultMap id="BaseResultMap" type="com.lty.model.entity.Book">
        <id column="id" property="id" />
        <result column="bookName" property="bookName" />
        <result column="type" property="type" />
        <result column="price" property="price" />
        <result column="createTime" property="createTime" />
        <result column="updateTime" property="updateTime" />
        <result column="isDelete" property="isDelete" />
    </resultMap>

    <sql id="Base_Column_List">
        t.id,
        t.bookName,
        t.type,
        t.price,
        t.createTime,
        t.updateTime,
        t.isDelete,
    </sql>

    <select id="pageList" resultMap="BaseResultMap">
        SELECT  <include refid="Base_Column_List"/>
        FROM book t
        <trim prefix="WHERE" prefixOverrides="AND | OR" >
        </trim>
    </select>

    <insert id="saveMapper" parameterType="com.lty.model.entity.Book" useGeneratedKeys="true" keyProperty="id" >
        INSERT INTO book (bookName,
                          type,
                          price)
        VALUES (#{bookName},
                #{type},
                #{price});
    </insert>

    <update id="updateMapper" parameterType="com.lty.model.entity.Book">
        UPDATE book
        SET
            bookName = #{bookName},
            type = #{type},
            price = #{price}
        WHERE id = #{id}
    </update>

    <delete id="deleteMapper" parameterType="java.util.HashMap">
        DELETE FROM book
        <trim prefix="WHERE" prefixOverrides="AND | OR" >
            <if test="ids != null">
                id IN
                <foreach item="item" collection="ids" separator="," open="(" close=")" index="">
                    #{item}
                </foreach>
            </if>
        </trim>
    </delete>

    <select id="selectBookList" resultType="com.lty.model.entity.Book">
        <bind name="likePattern" value="'%' + dto.bookName + '%'"/>
        select id, bookName, type, price, createTime, updateTime, isDelete
        from book t
        <where>
            t.isDelete=0
            <if test="dto.keyword!=null and dto.keyword!=''">
                and (t.bookName like concat('%',#{dto.bookName},'%') or t.type like concat('%',#{dto.type},'%'))
            </if>
            <if test="dto.bookName!=null and dto.bookName!=''">
                and t.bookName like concat('%',#{dto.bookName},'%')
            </if>
            <if test="dto.typeList != null and dto.typeList.size() > 0">
                and t.type in
                <foreach collection="dto.typeList" item="item" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <if test="dto.bookName != null and dto.bookName != ''">
                and t.bookName like #{likePattern}
            </if>
        </where>
    </select>
</mapper>
